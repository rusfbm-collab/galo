{
  "name": "galo-ai-public-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check && vite build && npm run claims:artifact",
    "preview": "vite preview --host 0.0.0.0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.mjs\" index.html vite.config.ts vitest.config.ts eslint.config.js postcss.config.js \"tsconfig*.json\" package.json package-lock.json amvera.yaml \"*.md\" \".github/**/*.yml\"",
    "lint": "eslint src tests vite.config.ts",
    "typecheck": "tsc -b",
    "claims:check": "node scripts/check-claims.mjs",
    "claims:artifact": "node scripts/check-built-claims.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run claims:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^8.0.13",
    "vitest": "^4.1.10"
  }
}
